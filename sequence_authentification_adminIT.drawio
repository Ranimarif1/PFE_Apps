<mxfile host="app.diagrams.net">
  <diagram id="seq_auth_adminIT" name="Séquence - Authentification Administrateur IT">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
